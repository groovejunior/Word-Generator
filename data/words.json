  "germanGap": [
    { "word": "accountability", "tier": "C1", "abstractness": 3, "gap": "German splits it across Verantwortung and Rechenschaftspflicht; neither carries the full English sense." },
    { "word": "commitment", "tier": "C1", "abstractness": 3, "gap": "Verpflichtung, Engagement and Hingabe each cover only a slice." },
    { "word": "privacy", "tier": "C1", "abstractness": 3, "gap": "Privatsphäre is spatial; English privacy also covers information and attention." },
    { "word": "entitlement", "tier": "C1", "abstractness": 3, "gap": "Anspruch is neutral and Anspruchsdenken is purely pejorative; English holds both." },
    { "word": "awkwardness", "tier": "C1", "abstractness": 3, "gap": "Peinlichkeit is embarrassment; awkwardness is about social friction, not shame." },
    { "word": "resentment", "tier": "C1", "abstractness": 3, "gap": "Ressentiment is a borrowed, bookish term in German; English resentment is everyday." },
    { "word": "closure", "tier": "C1", "abstractness": 3, "gap": "The emotional sense has no German noun at all." },
